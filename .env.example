DATABASE_URL=postgresql+psycopg://social_studio:social_studio@db:5432/social_studio
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_BYTES=2000000

# Create a webhook in a Discord channel you own. Leave blank until configured.
DISCORD_WEBHOOK_URL=
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=30
MAX_PUBLISH_ATTEMPTS=3
RETRY_BASE_SECONDS=5

# Optional Phase 6 LLM generation through OpenRouter. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_INPUT_CHARACTERS=30000
